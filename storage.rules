rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Avatars are private to their account. The app reads authenticated bytes,
    // never publishes tokenized download URLs or shares these with goal members.
    match /users/{uid}/profile/avatar/{file} {
      allow read: if owns(uid);
      allow create: if resource == null && owns(uid)
        && file.matches('^[A-Za-z0-9]{20}[.]jpg$')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      // Versioned objects are immutable. Replacement creates a new object.
      allow update: if false;
      allow delete: if owns(uid) && file.matches('^[A-Za-z0-9]{20}[.]jpg$');
    }
    function personalGoal(uid, gid) {
      return /databases/(default)/documents/users/$(uid)/goals/$(gid);
    }
    function sharedGoal(gid) {
      return /databases/(default)/documents/sharedGoals/$(gid);
    }
    function sharedOwner(gid) {
      return request.auth != null && firestore.get(sharedGoal(gid)).data.ownerId == request.auth.uid;
    }
    function activeMember(gid) {
      return request.auth != null
        && request.auth.uid in firestore.get(sharedGoal(gid)).data.memberIds
        && firestore.get(/databases/(default)/documents/sharedGoals/$(gid)/members/$(request.auth.uid)).data.status == 'active';
    }
    function validCoverFile(file) {
      return file.matches('^[A-Za-z0-9]{20}[.]jpg$')
        && request.resource.size > 0 && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
    match /users/{uid}/goals/{gid}/cover/{file} {
      allow get: if owns(uid) && firestore.exists(personalGoal(uid, gid));
      allow list: if false;
      allow create: if resource == null && owns(uid) && firestore.exists(personalGoal(uid, gid)) && validCoverFile(file);
      allow update: if false;
      allow delete: if owns(uid) && file.matches('^[A-Za-z0-9]{20}[.]jpg$')
        && (!firestore.exists(personalGoal(uid, gid))
          || firestore.get(personalGoal(uid, gid)).data.get('coverStoragePath', '') != 'users/' + uid + '/goals/' + gid + '/cover/' + file);
    }
    match /sharedGoals/{gid}/cover/{file} {
      allow get: if sharedOwner(gid) || (activeMember(gid)
        && firestore.get(sharedGoal(gid)).data.get('coverStoragePath', '') == 'sharedGoals/' + gid + '/cover/' + file);
      allow list: if false;
      allow create: if resource == null && sharedOwner(gid) && validCoverFile(file);
      allow update: if false;
      allow delete: if sharedOwner(gid) && file.matches('^[A-Za-z0-9]{20}[.]jpg$')
        && firestore.get(sharedGoal(gid)).data.get('coverStoragePath', '') != 'sharedGoals/' + gid + '/cover/' + file;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
