<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp" android:orientation="vertical" android:background="@drawable/st_widget_emerald">
<ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_launcher_monochrome" android:tint="#26B58E" android:importantForAccessibility="no"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Savings Goal" android:textColor="#D9F6E9" android:textSize="13sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your savings, at a glance" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
<ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginVertical="12dp" android:progressDrawable="@drawable/st_widget_progress_track" android:progress="40"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a goal to track progress" android:textColor="#D9F6E9" android:textSize="12sp"/>
</LinearLayout>