<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp" android:orientation="vertical" android:background="@drawable/st_widget_mint">
<ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_launcher_monochrome" android:tint="#26B58E" android:importantForAccessibility="no"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Today’s Planner" android:textColor="#526E61" android:textSize="13sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="2 tasks left" android:textColor="#14362B" android:textSize="22sp" android:textStyle="bold"/>
<ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginVertical="12dp" android:progressDrawable="@drawable/st_widget_progress_track_light" android:progress="33"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1 / 3 tasks completed · Sample preview" android:textColor="#526E61" android:textSize="12sp"/>
</LinearLayout>
